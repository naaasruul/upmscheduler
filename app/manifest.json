{
  "manifest_version": 3,
  "name": "Student Schedule Generator",
  "short_name": "Schedule Gen",
  "version": "0.1.0",
  "description": "Jana wallpaper jadual kelas (iPhone/iPad) dan fail .ics dari eSMP. Tidak rasmi, bukan aplikasi UPM.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://esmp.upm.edu.my/*"
  ],
  "background": {
    "service_worker": "ext/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://esmp.upm.edu.my/smp/*"
      ],
      "js": [
        "ext/content.js"
      ],
      "css": [
        "ext/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Student Schedule Generator: jana jadual dari eSMP",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png"
      ],
      "matches": [
        "https://esmp.upm.edu.my/*"
      ]
    }
  ]
}